{
  "name": "omlx-scope-openchamber",
  "version": "0.5.7",
  "description": "A lightweight oMLX and Mac resource monitor for OpenChamber",
  "private": true,
  "license": "MIT",
  "author": "mikebuckets171",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikebuckets171/omlx-scope-openchamber.git"
  },
  "homepage": "https://github.com/mikebuckets171/omlx-scope-openchamber",
  "bugs": {
    "url": "https://github.com/mikebuckets171/omlx-scope-openchamber/issues"
  },
  "keywords": [
    "openchamber",
    "omlx",
    "telemetry",
    "inference",
    "local-monitor"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "omlx-scope",
        "name": "OMLX Scope",
        "icon": "panel/scope-icon.svg",
        "entry": "panel/index.html"
      },
      "actions": [
        {
          "id": "open-omlx-scope",
          "label": "Open OMLX Scope",
          "icon": "panel/scope-icon.svg",
          "where": "session"
        }
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "/usr/bin/vm_stat",
            "/usr/sbin/sysctl"
          ]
        }
      },
      "page": true
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "bun build service/main.ts --target=node --format=esm --minify-whitespace --outfile=service/main.js",
    "type-check": "tsc --noEmit",
    "test": "bun test ./service ./src ./panel ./scripts",
    "preview": "bun run build:panel && bun dev/server.ts",
    "test:browser": "playwright test",
    "verify:package": "bun scripts/verify-package.ts",
    "check": "bun run type-check && bun run test && bun run build && bun run verify:package",
    "check:all": "bun run check && bun run test:browser"
  },
  "dependencies": {
    "@openchamber/sdk": "1.24.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/bun": "1.3.4",
    "@types/node": "24.3.1",
    "typescript": "5.9.3"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "panel/index.html",
    "panel/main.js",
    "panel/style.css",
    "panel/scope-icon.svg",
    "service/main.js",
    "docs/CONFIGURATION.md",
    "docs/METRICS.md"
  ]
}
