{
  "name": "omlx-scope-openchamber",
  "version": "0.3.0",
  "description": "Independent third-party OMLX Scope panel for OpenChamber",
  "private": true,
  "license": "MIT",
  "author": "mikebuckets171",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikebuckets171/omlx-scope-openchamber.git"
  },
  "homepage": "https://github.com/mikebuckets171/omlx-scope-openchamber",
  "bugs": {
    "url": "https://github.com/mikebuckets171/omlx-scope-openchamber/issues"
  },
  "keywords": [
    "openchamber",
    "omlx",
    "telemetry",
    "inference",
    "local-monitor"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "omlx-scope",
        "name": "OMLX Scope",
        "icon": "pulse",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "openchamber-guest-bundle --node service/main.ts service/main.js",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run type-check && bun test && bun run build"
  },
  "dependencies": {
    "@openchamber/sdk": "1.24.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "24.3.1",
    "typescript": "5.9.3"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "panel",
    "service"
  ]
}
